{
  "version": 2,
  "rewrites": [
    {
      "source": "/news/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[fF]acebookcatalog|[tT]witterbot|[xX]bot|[lL]inked[iI]n[bB]ot|[tT]elegram[bB]ot|[sS]lackbot|[dD]iscordbot|[aA]pplebot|[pP]interest|[mM]eta-[eE]xternal|[sS]kype[uU]ri[pP]review|[gG]ooglebot|[bB]ingbot).*"
        }
      ],
      "destination": "/api/news/[id]?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
