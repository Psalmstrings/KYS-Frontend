{
  "rewrites": [
    {
      "source": "/news/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|applebot).*"
        }
      ],
      "destination": "/api/news/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
